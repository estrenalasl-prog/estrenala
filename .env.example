# Connection string del proyecto Supabase (Project Settings → Database → Connection string → URI)
# En dev se usa el transaction pooler (puerto 6543) con prepare:false
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Carpeta local del StorageAdapter (impl. de disco). Por defecto data/storage
STORAGE_DIR=data/storage
# Secreto que firma la cookie de sesión (HMAC). Desde el incremento 6 las cuentas
# son por usuario (registro/login con email+contraseña); ya no hay PANEL_PASSWORD.
SESSION_SECRET=
# Clave maestra (32 bytes en base64) que cifra las claves de IA que cada espacio
# pega en Configuración (org_settings). Son credenciales DE TERCEROS con dinero
# detrás: sin esto se guardarían en claro. Genérala con:  openssl rand -base64 32
# OJO: si la cambias, las claves ya guardadas dejan de poder leerse y sus dueños
# tienen que volver a pegarlas. No es la misma que SESSION_SECRET.
SECRETS_KEY=
# --- IA: CADA ESPACIO PAGA LA SUYA (BYOK) ---
# NO hay aquí ninguna clave de IA, y es a propósito. Cada organización pega la
# suya en Configuración → Conexiones y claves, y se guarda cifrada (SECRETS_KEY).
# Sin clave propia, las funciones de IA quedan desactivadas para ese espacio.
#
# Hubo un respaldo a OPENROUTER_API_KEY / SERPAPI_KEY de este fichero y se quitó:
# significaba que la IA de los clientes la pagaba la plataforma. Con cuatro
# usuarios es calderilla; con mil es una factura sin control que crece cuanto
# mejor va el negocio. Si dejas esas variables puestas, hoy NO hacen nada.
#
# Modelo por defecto de la plataforma. Esto NO es una clave: solo dice con qué
# modelo se redacta cuando el espacio no ha elegido otro. No cuesta dinero.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Modelo de IMAGEN para las portadas (céntimos por imagen; independiente del de texto)
# OPENROUTER_MODEL_IMAGEN=google/gemini-2.5-flash-image
# Correo transaccional (verificación, recuperar contraseña, invitaciones). SIN esto,
# en dev los correos se imprimen en la consola del servidor (con el enlace). Al
# desplegar: crea cuenta en resend.com (gratis 3.000/mes), verifica estrenala.com
# y pega aquí la clave. EMAIL_FROM debe ser de un dominio verificado en Resend.
# RESEND_API_KEY=
# EMAIL_FROM=Estrénala <no-responder@estrenala.com>
# Dominio de la plataforma (para construir los enlaces de los correos en prod).
# PLATFORM_HOST=app.estrenala.com
# «Continuar con Google» (OAuth). Sin esto, el botón no aparece. Crea las
# credenciales en Google Cloud Console → APIs y servicios → Credenciales → ID de
# cliente OAuth (tipo Aplicación web). Redirect URI autorizado:
#   http://localhost:3000/api/auth/google/callback  (dev)
#   https://<PLATFORM_HOST>/api/auth/google/callback (prod)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Publicación programada: el servidor ya publica solo (tick cada 60 s). Si además
# usas un cron externo contra POST /api/cron/publicar, protégelo con este secreto.
# CRON_SECRET=
# Candado de pre-lanzamiento: con esto puesto, TODA la plataforma sale con
# «X-Robots-Tag: noindex, nofollow» y su robots.txt prohíbe el rastreo entero.
# Hace falta porque el dominio ya es público en cuanto se emite el certificado
# (Let's Encrypt lo publica en los registros de Certificate Transparency, que hay
# bots rastreando). QUITARLO EL DÍA DEL LANZAMIENTO. No afecta a las webs de los
# clientes: cada una tiene su propio interruptor en su pantalla de proyecto.
# PLATAFORMA_NOINDEX=1

# Analítica de visitas de la plataforma (Umami autoalojado). SIN cookies, por eso
# no hace falta banner de consentimiento y /legal/cookies sigue siendo verdad.
# Sin estas dos variables no se pinta nada (es lo que quieres en desarrollo).
# Ninguna es secreta: el navegador las ve en el HTML.
# UMAMI_SRC=https://analitica.estrenala.com/script.js
# UMAMI_WEBSITE_ID=

# --- Pagos (Stripe) ---
# Clave secreta: sk_test_… en pruebas, sk_live_… en producción.
STRIPE_SECRET_KEY=
# Secreto del webhook (whsec_…). En local lo da `stripe listen`; en producción,
# el que muestre el endpoint creado en el panel de Stripe.
STRIPE_WEBHOOK_SECRET=
# IDs de precio del catálogo. OJO: los de modo prueba NO valen en producción.
STRIPE_PRICE_PERSONAL_MES=
STRIPE_PRICE_PERSONAL_ANUAL=
STRIPE_PRICE_AGENCIA_MES=
STRIPE_PRICE_AGENCIA_ANUAL=
