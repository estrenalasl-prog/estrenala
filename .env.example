# Connection string del proyecto Supabase (Project Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Carpeta local del StorageAdapter (impl. de disco). Por defecto data/storage
STORAGE_DIR=data/storage
# IA vía OpenRouter (plantillas del blog y redacción de artículos)
OPENROUTER_API_KEY=
# Modelo por defecto de la plataforma (cada proyecto puede elegir el suyo en la UI)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Radar de keywords (Google Trends vía SerpAPI; clave gratuita en serpapi.com, 100 búsquedas/mes)
SERPAPI_KEY=
